# Cloud data for Paperweave: the same database and PDF storage for every computer you use.
# Copy this file to .env.cloud (never commit it), fill it in, then run:
#   npm run cloud:move            — check both sides (dry run)
#   npm run cloud:move -- --apply — copy this computer's data to the cloud and verify it
# Afterwards copy these values into .env (replacing the local DATABASE_URL / S3_* lines) on every computer.
# Full guide: SETUP.md ("Several computers, cloud data")

# Neon → your project → Connect → "Connection string", with "Connection pooling" OFF (the direct string).
# Pick Postgres 17 or newer and the region closest to you when creating the project.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Cloudflare R2 → create a bucket, then "Manage API tokens" → Create token with
# "Object Read & Write" for that bucket. The endpoint is shown with the token (S3 API).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=paperweave
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
