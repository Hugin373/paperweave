# ---------------------------------------------------------------------------
# Paperweave configuration. Copy to `.env` and adjust.
# Values below match `docker compose up -d` for local development.
# ---------------------------------------------------------------------------

# Public URL of the app (used for auth callbacks, share links, cookies).
APP_URL=http://localhost:3300
# Other addresses you open Paperweave at (comma-separated), e.g. your Tailscale URL for phone access:
# TRUSTED_ORIGINS=https://my-pc.tailnet-name.ts.net

# PostgreSQL connection string.
DATABASE_URL=postgres://paperweave:paperweave@localhost:5433/paperweave

# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 32-byte key (base64) used to encrypt stored AI provider API keys.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Object storage (uploaded / open-access PDFs) --------------------------
# STORAGE_DRIVER=s3 uses any S3-compatible service (AWS S3, R2, SeaweedFS, MinIO…).
# STORAGE_DRIVER=local stores files on disk under STORAGE_LOCAL_DIR (single-server only).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=paperweave
S3_ACCESS_KEY_ID=paperweave
S3_SECRET_ACCESS_KEY=paperweave-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
STORAGE_LOCAL_DIR=./data/files
# Maximum PDF size in megabytes.
MAX_PDF_MB=60

# --- Scholarly data sources --------------------------------------------------
# Comma-separated provider order for discovery and citations.
# Supported: semantic_scholar, openalex. Failover happens automatically.
SCHOLARLY_PROVIDERS=semantic_scholar,openalex
# Optional but strongly recommended: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
# Contact e-mail sent to OpenAlex / Crossref "polite pools", and required by Unpaywall (which finds
# legal free PDFs by DOI). Without it, Unpaywall is not used and journal papers known only by a DOI
# get no "Get PDF" button. With it, saved papers are checked in the background.
SCHOLARLY_CONTACT_EMAIL=
# OpenAlex API key (free; without one a small daily budget is shared per IP address).
OPENALEX_API_KEY=
# Europe PMC (biomedical: PubMed, PubMed Central, medRxiv/bioRxiv) needs no key.
# Optional OpenReview account (https://openreview.net/signup): OpenReview search works without it,
# but reading reviews/decisions and downloading submission PDFs requires signing in.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
# Cache lifetime for external scholarly responses, in hours.
SCHOLARLY_CACHE_TTL_HOURS=168

# --- AI (optional) ----------------------------------------------------------
# Users configure their own provider in Settings → AI. These settings control
# what the server allows.
# Allow user-configured AI endpoints on private/loopback networks (e.g. Ollama on
# localhost). Set to false on multi-tenant deployments to prevent SSRF.
AI_ALLOW_PRIVATE_ENDPOINTS=true
# Enables the deterministic "mock" provider. Only for automated tests/demo.
AI_ENABLE_MOCK_PROVIDER=false
# Request timeout for AI providers in seconds.
AI_TIMEOUT_SECONDS=120
# Allow the "Claude subscription (via Claude Code)" and "ChatGPT subscription (via Codex)"
# providers, which run the claude / codex CLIs installed and signed in on this machine.
# Everyone using this server would use that subscription, so it defaults to on only
# outside production. Paths default to "claude" and "codex" on PATH.
# AI_ENABLE_SUBSCRIPTION_CLI=true
# AI_CLAUDE_CODE_PATH=claude
# AI_CODEX_PATH=codex

# --- Background jobs ---------------------------------------------------------
# Run the job worker inside the web process (simplest deployment).
# When running several app replicas, it is fine to enable it on all of them
# (jobs are claimed with row locks) or on just one.
# Meaning-based search with a local embedding model (downloaded once, ~35 MB; nothing leaves this machine).
# EMBEDDINGS=true
# EMBEDDING_MODEL=Xenova/bge-small-en-v1.5   # multilingual: Xenova/multilingual-e5-small
RUN_WORKER_IN_PROCESS=true

# --- Registration & sign-in --------------------------------------------------
# Rate limiting of sign-in/sign-up attempts in production (per instance).
AUTH_RATE_LIMIT=true
# Set to false to disable public sign-up.
ALLOW_REGISTRATION=true
# Single-user mode: no sign-in page; requests to this computer, APP_URL or TRUSTED_ORIGINS act as this account.
# Only for an instance nobody else can reach (see SETUP.md, "Single-user mode").
# SINGLE_USER_EMAIL=you@example.com
